# Скопируй этот файл в .env и заполни ключи

# OpenRouter API — получить на https://openrouter.ai/keys
# Регистрация бесплатная, при входе даётся $1 кредит
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jina AI API — получить на https://jina.ai/embeddings/
# Бесплатный tier: 1 млн токенов/месяц
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Модели (open-weight через OpenRouter)
VLM_MODEL=qwen/qwen3-vl-32b-instruct
LLM_MODEL=meta-llama/llama-4-maverick
VERIFIER_MODEL=meta-llama/llama-4-maverick

# Настройки скорости индексации (опционально)
# VLM_WORKERS=2
# VLM_RATE_INTERVAL=2.0
